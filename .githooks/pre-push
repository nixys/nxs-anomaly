#!/usr/bin/env sh
# Local pre-push hook: a release tag is what the CI pipeline builds, signs and
# publishes, so the tag must agree with ./VERSION and with every file derived
# from it. Pushing `v0.1.29` while Chart.yaml still says 0.1.27 publishes a chart
# whose default image tag was never pushed — that is the failure this prevents.
# Enable once per clone:  git config core.hooksPath .githooks
#
# git feeds refs on stdin as: <local ref> <local sha> <remote ref> <remote sha>
set -eu

check="$(dirname "$0")/../scripts/check-version.sh"
rc=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
	case "$local_ref" in
	refs/tags/*) ;;
	*) continue ;;
	esac

	# A deletion pushes the all-zero sha; nothing to validate.
	case "$local_sha" in
	*[!0]*) ;;
	*) continue ;;
	esac

	tag="${local_ref#refs/tags/}"
	case "$tag" in
	v[0-9]*)
		# Validate the commit the tag points at, not the working tree: that is
		# what CI will check out.
		tmp="$(mktemp -d)"
		trap 'rm -rf "$tmp"' EXIT
		# No fallback to the working tree if the tagged commit cannot be read:
		# validating something other than what CI will build is worse than not
		# validating at all. A commit that predates VERSION cannot be released.
		if git archive "$local_sha" VERSION deploy/helm/nxs-anomaly/Chart.yaml \
			deploy/helm/nxs-anomaly/README.md docs/openapi.json scripts/check-version.sh |
			tar -x -C "$tmp" 2>/dev/null; then
			sh "$tmp/scripts/check-version.sh" --tag "$tag" ||
				{ echo "pre-push: refusing to push tag $tag" >&2; rc=1; }
		else
			echo "pre-push: $tag points at $(git rev-parse --short "$local_sha"), which does not carry the release version files; refusing to push it" >&2
			rc=1
		fi
		rm -rf "$tmp"
		trap - EXIT
		;;
	*)
		echo "pre-push: tag '$tag' is not a release tag (vX.Y.Z); not validated" >&2
		;;
	esac
done

exit "$rc"
