# Copy to .env before `docker compose up -d`. Compose reads .env from this
# directory automatically; nothing here has a working default, so an unset
# required variable fails the affected container at startup instead of
# starting it with a guessable credential.
#
#   cp .env.example .env
#   edit .env: real values for the three variables below
#   docker compose up -d
#
# This file pairs with docker-compose.yml, which builds the images from
# source — the developer/contributor path. The published community edition
# additionally ships an image-based docker-compose.yml (renamed to
# docker-compose.dev.yml there, with this file as .env.dev.example) that pulls
# a versioned, signed release instead of building — see the Docker Compose
# section of docs/community/en/SETUP.md.

# Required. PostgreSQL password for the nxs_anomaly user, and the password half
# of the app/worker connection DSN.
POSTGRES_PASSWORD=

# Required. Bootstrap admin account — the account you sign in with the first
# time. Re-applied on every start; unset both once real accounts exist.
NXS_ANOMALY_BOOTSTRAP_ADMIN_USERNAME=admin
NXS_ANOMALY_BOOTSTRAP_ADMIN_PASSWORD=
