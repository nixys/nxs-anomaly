# Copy to .env before `docker compose up -d`. Compose reads .env from this
# directory automatically; nothing here has a working default, so an unset
# required variable fails the affected container at startup instead of
# starting it with a guessable credential.
#
#   cp .env.example .env
#   edit .env: real values below
#   docker compose up -d
#
# To build from source instead of pulling published images, use
# `docker compose -f docker-compose.dev.yml up -d --build` — see
# docs/community/en/SETUP.md.

# Required. The release to run — a tag from
# https://github.com/nixys/nxs-anomaly/releases, matching the checkout.
NXS_ANOMALY_VERSION=

# Required. PostgreSQL password for the nxs_anomaly user, and the password half
# of the app/worker connection DSN.
POSTGRES_PASSWORD=

# Required. Bootstrap admin account — the account you sign in with the first
# time. Re-applied on every start; unset both once real accounts exist.
NXS_ANOMALY_BOOTSTRAP_ADMIN_USERNAME=admin
NXS_ANOMALY_BOOTSTRAP_ADMIN_PASSWORD=

# Optional automation key for curl/Terraform. Generate with: openssl rand -hex 32
NXS_ANOMALY_API_KEY=

# Optional delivery transports; .env is loaded by API and worker.
NXS_ANOMALY_TELEGRAM_BOT_TOKEN=
NXS_ANOMALY_SMTP_HOST=
NXS_ANOMALY_SMTP_PORT=587
NXS_ANOMALY_SMTP_USERNAME=
NXS_ANOMALY_SMTP_PASSWORD=
NXS_ANOMALY_SMTP_SENDER=
NXS_ANOMALY_SMTP_USE_TLS=true
