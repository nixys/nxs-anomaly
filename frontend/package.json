{
  "name": "nxs-anomaly-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "design:export": "playwright test --config playwright.design.config.ts",
    "design:capture": "playwright test --config playwright.design.config.ts capture.spec.ts",
    "design:tokens": "playwright test --config playwright.design.config.ts tokens.spec.ts",
    "audit:prod": "node scripts/audit-gate.mjs --level=high --omit-dev",
    "audit:dev": "node scripts/audit-gate.mjs --level=critical",
    "openapi:types": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "openapi:check": "openapi-typescript ../docs/openapi.json -o /tmp/nxs-anomaly-schema.d.ts && diff -u src/api/schema.d.ts /tmp/nxs-anomaly-schema.d.ts",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/dates": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@mantine/notifications": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "dayjs": "^1.11.23",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
