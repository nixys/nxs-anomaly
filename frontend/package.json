{
  "name": "nxs-anomaly-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "design:export": "playwright test --config playwright.design.config.ts",
    "design:capture": "playwright test --config playwright.design.config.ts capture.spec.ts",
    "design:tokens": "playwright test --config playwright.design.config.ts tokens.spec.ts",
    "audit:prod": "node scripts/audit-gate.mjs --level=high --omit-dev",
    "audit:dev": "node scripts/audit-gate.mjs --level=critical",
    "openapi:types": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "openapi:check": "openapi-typescript ../docs/openapi.json -o /tmp/nxs-anomaly-schema.d.ts && diff -u src/api/schema.d.ts /tmp/nxs-anomaly-schema.d.ts",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/dates": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "@tabler/icons-react": "^3.30.0",
    "@tanstack/react-query": "^5.66.0",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "~1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
