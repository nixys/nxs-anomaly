# Optional. Set a bot token before testing Telegram delivery.
NXS_ANOMALY_TELEGRAM_BOT_TOKEN=

# Alternatively, configure an SMTP server supporting STARTTLS.
NXS_ANOMALY_SMTP_HOST=
NXS_ANOMALY_SMTP_PORT=587
NXS_ANOMALY_SMTP_USERNAME=
NXS_ANOMALY_SMTP_PASSWORD=
NXS_ANOMALY_SMTP_SENDER=
NXS_ANOMALY_SMTP_USE_TLS=true
